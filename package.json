{
  "name": "ai-prompt-generator",
  "version": "2.1.0",
  "description": "A comprehensive AI prompt generation tool with style references, 20+ AI models, and advanced parameters",
  "main": "electron-main.js",
  "homepage": "./",
  "scripts": {
    "css:build": "tailwindcss -i src/styles.css -o tailwind.css --minify",
    "css:watch": "tailwindcss -i src/styles.css -o tailwind.css --watch",
    "start": "npm run css:build && electron .",
    "build": "npm run css:build && electron-builder",
    "build-win": "npm run css:build && electron-builder --win",
    "build-mac": "npm run css:build && electron-builder --mac",
    "build-linux": "npm run css:build && electron-builder --linux",
    "pack": "npm run css:build && electron-builder --dir",
    "dist": "npm run css:build && electron-builder --publish=never",
    "serve": "npm run css:build && python3 -m http.server 8080",
    "dev": "npm run css:watch & python3 -m http.server 8080"
  },
  "keywords": [
    "ai",
    "prompt",
    "generator",
    "midjourney",
    "dalle",
    "stable-diffusion",
    "sref",
    "style-reference",
    "flux",
    "ideogram",
    "sora",
    "electron",
    "pwa"
  ],
  "author": {
    "name": "Prompt Helper",
    "email": "contact@example.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "tailwindcss": "^4.2.2"
  },
  "build": {
    "appId": "com.aipromptgenerator.app",
    "productName": "Prompt Helper",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "app.js",
      "tutorial.html",
      "sw.js",
      "manifest.json",
      "electron-main.js",
      "tailwind.css",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
